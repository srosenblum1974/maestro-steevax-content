{
 "title": {
  "fr": "Steevax Jazz Club",
  "en": "Steevax Jazz Club"
 },
 "tagline": {
  "fr": "Le même entrepreneur ouvre une deuxième porte : le jazz, morceau après morceau.",
  "en": "The same entrepreneur opens a second door: jazz, one tune at a time."
 },
 "ritual": [
  {
   "id": "decouvrir",
   "title": {
    "fr": "Étape 1 : Découvrir",
    "en": "Step 1: Discover"
   },
   "text": {
    "fr": "Vous écoutez sans rien chercher, puis vous dites ce que vous avez ressenti en touchant des icônes.",
    "en": "You listen without looking for anything, then tap icons to say what you felt."
   }
  },
  {
   "id": "reperer",
   "title": {
    "fr": "Étape 2 : Repérer",
    "en": "Step 2: Spot"
   },
   "text": {
    "fr": "Vous réécoutez avec une mission : reconnaître les moments clés et deviner les instruments.",
    "en": "You listen again on a mission: recognise the key moments and guess the instruments."
   }
  },
  {
   "id": "retenir",
   "title": {
    "fr": "Étape 3 : Retenir",
    "en": "Step 3: Remember"
   },
   "text": {
    "fr": "Quelques jours plus tard, un mini-quiz et une dernière écoute. Vous gardez une note et un souvenir.",
    "en": "A few days later, a mini-quiz and one last listen. You keep a rating and a memory."
   }
  }
 ],
 "notebook": {
  "fr": "À chaque œuvre, votre carnet se remplit tout seul : émotions, images, instruments, note. Tout apparaît dans l'onglet Carnet.",
