 "history": {
  "intro": {
   "fr": "Un siècle de jazz en cinq chapitres. Retenez juste l'ambiance de chacun.",
   "en": "A century of jazz in five chapters. Just remember the mood of each."
  },
  "before": {
   "fr": "Avant 1910 : le blues des champs du Sud, les chants d'église (gospel), le ragtime au piano et les fanfares de La Nouvelle-Orléans. Le jazz naît de leur rencontre, chez les Afro-Américains.",
   "en": "Before 1910: the blues of Southern fields, church songs (gospel), ragtime piano and New Orleans brass bands. Jazz is born where they meet, among African Americans."
  },
  "periods": [
   {
    "id": "nouvelle-orleans",
    "title": {
     "fr": "Nouvelle-Orléans",
     "en": "New Orleans"
    },
    "dates": "1910–1930",
    "oneLine": {
     "fr": "La musique des fanfares et des cabarets, où tout le monde improvise ensemble.",
     "en": "Brass-band and cabaret music, where everyone improvises together."
    },
    "world": {
     "fr": "La ville portuaire mêle cultures africaines, créoles et européennes ; puis les musiciens migrent vers Chicago.",
     "en": "The port city mixes African, Creole and European cultures; then musicians move north to Chicago."
    },
    "sound": {
     "fr": "Trompette, clarinette, trombone qui s'entrelacent ; banjo et tuba ; naissance du soliste avec Armstrong.",
     "en": "Trumpet, clarinet and trombone intertwined; banjo and tuba; the soloist is born with Armstrong."
    },
    "people": [
     "King Oliver",
     "Louis Armstrong",
     "Jelly Roll Morton",
     "Sidney Bechet"
    ],
    "weeks": [
     1
    ]
   },
   {
    "id": "swing",
    "title": {
     "fr": "Swing",
     "en": "Swing"
    },
    "dates": "1930–1945",
    "oneLine": {
     "fr": "Le jazz devient la musique de danse de toute l'Amérique.",
     "en": "Jazz becomes all of America's dance music."
    },
    "world": {
     "fr": "La Grande Dépression, puis la guerre ; les grands orchestres jouent dans les dancings et à la radio.",
     "en": "The Great Depression, then war; big bands play ballrooms and radio."
    },
    "sound": {
     "fr": "Big bands de quinze musiciens, sections de cuivres et de saxophones, rythme qui balance.",
     "en": "Fifteen-piece big bands, brass and sax sections, a swinging beat."
    },
    "people": [
     "Duke Ellington",
     "Count Basie",
     "Benny Goodman",
     "Billie Holiday",
     "Ella Fitzgerald"
    ],
    "weeks": [
     4
    ]
   },
   {
    "id": "bebop",
    "title": {
     "fr": "Bebop",
     "en": "Bebop"
    },
    "dates": "1945–1955",
    "oneLine": {
     "fr": "Le jazz quitte la piste de danse pour devenir un art d'écoute, rapide et virtuose.",
     "en": "Jazz leaves the dance floor to become a fast, virtuosic art for listening."
    },
    "world": {
     "fr": "Les petits clubs de la 52e rue à New York, l'après-guerre.",
     "en": "The small clubs of 52nd Street in New York, the post-war years."
    },
    "sound": {
     "fr": "Petites formations, tempos très rapides, harmonies complexes.",
     "en": "Small groups, very fast tempos, complex harmony."
    },
    "people": [
     "Charlie Parker",
     "Dizzy Gillespie",
     "Thelonious Monk",
     "Bud Powell"
    ],
    "weeks": [
     5
    ]
   },
   {
    "id": "cool-modal",
    "title": {
     "fr": "Cool, hard bop et modal",
     "en": "Cool, hard bop and modal"
    },
    "dates": "1950–1965",
    "oneLine": {
     "fr": "Le jazz se diversifie : détendu, ardent ou méditatif.",
     "en": "Jazz branches out: relaxed, fiery or meditative."
    },
    "world": {
     "fr": "Le microsillon permet des morceaux longs ; le jazz s'écoute chez soi et sur les campus.",
     "en": "The LP allows long tracks; jazz is heard at home and on campus."
    },
    "sound": {
     "fr": "Sons plus doux (cool), racines blues et gospel (hard bop), longues plages sur une gamme (modal).",
     "en": "Softer sounds (cool), blues and gospel roots (hard bop), long stretches on one scale (modal)."
    },
    "people": [
     "Miles Davis",
     "John Coltrane",
